# Copy the relevant values into Appwrite (Console → Functions → <function> → Settings → Environment variables,
# or Project → Settings → Global variables). Never commit real keys.

# ai function
ANTHROPIC_API_KEY=sk-ant-...
MODEL_QUICK=claude-haiku-5-5        # live patient and examiner replies (fast)
MODEL_DEFAULT=claude-sonnet-5-5
MODEL_COMPLEX=claude-sonnet-5-5     # station marking; set claude-opus-5-5 for the most thorough (and most expensive) marking
FREE_AI_PER_DAY=25                  # free accounts: AI turns per day
PRO_AI_PER_DAY=800                  # Pro fair-use cap per day

# checkout, portal, stripe-webhook functions (start in Stripe TEST mode: sk_test_...)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...           # the recurring Pro price in GBP
STRIPE_WEBHOOK_SECRET=whsec_...     # from the webhook endpoint you create for the stripe-webhook function
SITE_URL=https://your-site.appwrite.network

# only if a function can't use its dynamic key (x-appwrite-key)
APPWRITE_API_KEY=

# web site build (Sites → Settings → Environment variables)
APPWRITE_ENDPOINT=https://<region>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=<your project id>
